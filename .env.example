# Optional data.gov.sg key for higher API limits.
DATA_GOV_SG_API_KEY=

# Required only for optional OneMap block geocoding.
ONEMAP_API_TOKEN=

# Optional Streamlit override for a CSV or Parquet snapshot.
HDB_DATA_PATH=

# Optional: enables the evidence-grounded copilot. Never commit a real key.
OPENAI_API_KEY=

# Optional copilot controls.
HDB_COPILOT_MODEL=gpt-5.6-terra
HDB_COPILOT_MAX_REQUESTS=8
